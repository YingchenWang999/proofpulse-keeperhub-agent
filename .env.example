# Sepolia is the safe default. Mainnet is rejected unless explicitly enabled.
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=
# Copy this value from the reviewed dry-run snapshot before setting DRY_RUN=false.
EXPECTED_CONTRACT_CODE_SHA256=

# KeeperHub CLI. Authenticate interactively with `kh auth login`, or set
# KH_API_KEY in your shell. Never commit an API key.
KH_BIN=kh
KH_TIMEOUT=5m

# Safety defaults
DRY_RUN=true
FORCE_RECORD=false
AUTO_RECORD=false
ALLOW_MAINNET=false
RPC_TIMEOUT_MS=10000
OLLAMA_TIMEOUT_MS=30000
KH_PROCESS_TIMEOUT_MS=360000
MAX_BLOCK_LAG_SECONDS=120
MAX_BASE_FEE_GWEI=100

# `rules` is free and deterministic. `ollama` uses a local model and then
# applies the same deterministic safety policy before execution.
EVALUATOR_MODE=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional metadata
AGENT_NAME=ProofPulse
ARTIFACT_DIR=artifacts
